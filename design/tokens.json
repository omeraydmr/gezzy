{
  "$name": "Kartpostal",
  "color": {
    "light": {
      "canvas": "#ECECEC",
      "surface": "#F5F5F5",
      "tray": "#FFFFFF",
      "ink": "#1C1D21",
      "ink-2": "#6B6F78",
      "ink-3": "#A9ACB3",
      "line": "#E6E6E8",
      "track": "#E9E9EB",
      "success": "#2E8B6A"
    },
    "dark": {
      "canvas": "#0F1012",
      "surface": "#1A1B1E",
      "tray": "#24262A",
      "ink": "#F2F2F3",
      "ink-2": "#A3A7AF",
      "ink-3": "#6E727A",
      "line": "#33363B",
      "track": "#2C2F34",
      "success": "#4CC198"
    },
    "category": {
      "stays":      { "base": "#3EC58F", "tint": "#E3F6EE", "tintDark": "#183A2E" },
      "flights":    { "base": "#5B78EE", "tint": "#E7ECFD", "tintDark": "#1E2647" },
      "food":       { "base": "#F2814A", "tint": "#FDEDE4", "tintDark": "#45261A" },
      "activities": { "base": "#D158D6", "tint": "#F9E6FA", "tintDark": "#3E1E40" }
    }
