  "radius": { "module": 32, "tray": 24, "thumb": 14, "pill": 999 },
  "space": [4, 8, 12, 16, 20, 24, 32],
  "shadow": {
    "card": "0 1px 2px rgba(0,0,0,.04), 0 8px 24px rgba(0,0,0,.06)",
